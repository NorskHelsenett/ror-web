{
  "name": "@ror/react",
  "private": false,
  "version": "0.0.6",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "types": "./dist/main.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./components/button": {
      "import": "./dist/components/button/index.js",
      "types": "./dist/components/button/index.d.ts"
    },
    "./components/table": {
      "import": "./dist/components/table/index.js",
      "types": "./dist/components/table/index.d.ts"
    },
    "./src/components/*": {
      "import": "./src/components/*.tsx"
    },
    "./src/components/button": {
      "import": "./src/components/button/index.tsx",
      "types": "./src/components/button/index.d.ts"
    },
    "./components/src/table": {
      "import": "./src/components/table/index.js",
      "types": "./src/components/table/index.d.ts"
    },
    "./utils/sorting": {
      "import": "./dist/utils/sorting.js",
      "types": "./dist/utils/sorting.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -b ./tsconfig.app.json && vite build",
    "lint": "eslint ./src",
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "fast-glob": "^3.3.3",
    "globals": "^15.14.0",
    "rollup-plugin-preserve-directives": "0.4.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.8",
    "clipboard-copy": "4.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.475.0",
    "motion": "12.4.10"
  }
}
