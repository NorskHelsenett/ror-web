{
  "name": "@ror/react",
  "private": false,
  "version": "0.0.6",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "types": "./dist/main.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./components/button": {
      "import": "./dist/components/button/index.js",
      "types": "./dist/components/button/index.d.ts"
    },
    "./components/table": {
      "import": "./dist/components/table/index.js",
      "types": "./dist/components/table/index.d.ts"
    },
    "./components/content-switch": {
      "import": "./dist/components/content-switch/index.js",
      "types": "./dist/components/content-switch/index.d.ts"
    },
    "./src/components/*": {
      "import": "./src/components/*.tsx"
    },
    "./src/components/button": {
      "import": "./src/components/button/index.tsx",
      "types": "./src/components/button/index.d.ts"
    },
    "./components/src/table": {
      "import": "./src/components/table/index.js",
      "types": "./src/components/table/index.d.ts"
    },
    "./components/src/content-switch": {
      "import": "./src/components/content-switch/index.js",
      "types": "./src/components/content-switch/index.d.ts"
    },
    "./utils/sorting": {
      "import": "./dist/utils/sorting.js",
      "types": "./dist/utils/sorting.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -b ./tsconfig.app.json && vite build",
    "lint": "eslint ./src",
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "format": "prettier . --check --cache --cache-location='node_modules/.cache/.prettiercache'",
    "format:fix": "prettier . --write --cache --cache-location='node_modules/.cache/.prettiercache' --log-level=warn"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-glob": "^3.3.3",
    "globals": "^16.0.0",
    "rollup-plugin-preserve-directives": "0.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.3"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "clipboard-copy": "4.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.487.0"
  }
}
