{
  "name": "@ror/design",
  "version": "0.0.6",
  "private": true,
  "exports": {
    "./style.css": "./dist/index.css",
    "./reset.css": "./dist/reset.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "sass src/index.scss:dist/index.css src/reset.scss:dist/reset.css",
    "dev": "sass --watch src/index.scss:dist/index.css src/reset.scss:dist/reset.css",
    "clean": "rm -rf dist && rm -rf .turbo"
  },
  "devDependencies": {
    "sass": "^1.83.4"
  },
  "peerDependencies": {
    "sass": "^1.83.4"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  }
}
